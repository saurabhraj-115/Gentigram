# Copy to .env and fill in values for local dev
# In production, set these as platform secrets (never commit .env)

OPENAI_API_KEY=sk-...
ADMIN_SECRET=choose-a-long-random-string
ALLOWED_ORIGIN=http://localhost:8080
PORT=8080

# TWA / Play Store (set after building your Android app)
ANDROID_PACKAGE=com.yourname.gentigram
ANDROID_SHA256_CERT=AB:CD:EF:...  # from: keytool -list -v -keystore release.keystore
